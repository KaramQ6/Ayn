# ForestGuard AI - Environment Variables
# Copy this to .env and fill in your API keys

# ── Server ──────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Demo Mode ───────────────────────────────────
# Set to "true" to auto-seed database and auto-start the 3-minute demo scenario on server launch
DEMO_MODE=true

# ── Telegram Bot (get from @BotFather) ──────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── NASA FIRMS (https://firms.modaps.eosdis.nasa.gov/api/area/) ──
NASA_FIRMS_API_KEY=your_nasa_firms_key_here

# ── OpenWeatherMap (https://openweathermap.org/api) ──
OPENWEATHER_API_KEY=your_openweather_key_here

# ── Google Cloud Vision AI (for photo analysis) ──
# Path to your Google Cloud service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# ── Security ────────────────────────────────────
# Comma-separated list of allowed origins in production (e.g. https://forestguard.example.com)
CORS_ORIGIN=

# ── Auth ────────────────────────────────────────
# Strong secret for signing JWT access tokens
JWT_SECRET=change_me_to_a_long_random_secret
# Access token TTL
JWT_EXPIRES_IN=7d

# ── Avatar Upload (Cloudinary optional) ────────
# If Cloudinary vars are empty, server falls back to local /uploads storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Supabase (for community data account deletion) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Satellite Fire Cause Analysis ───────────────────
# Google Gemini Flash (FREE: 1500 req/day, 15 RPM)
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Sentinel-2 via Copernicus Data Space (FREE: 30,000 processing units/month)
# Register at: https://dataspace.copernicus.eu → OAuth clients
# Gives 10m-resolution SWIR imagery (best for fire analysis)
# If empty, falls back to NASA GIBS MODIS (250m, no key needed)
SENTINELHUB_CLIENT_ID=your_sentinelhub_client_id_here
SENTINELHUB_CLIENT_SECRET=your_sentinelhub_client_secret_here
