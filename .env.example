# ForestGuard AI - Environment Variables
# Copy this to .env and fill in your API keys

# ── Server ──────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Demo Mode ───────────────────────────────────
# Set to "true" to auto-seed database and auto-start the 3-minute demo scenario on server launch
DEMO_MODE=true

# ── Telegram Bot (get from @BotFather) ──────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── NASA FIRMS (https://firms.modaps.eosdis.nasa.gov/api/area/) ──
NASA_FIRMS_API_KEY=your_nasa_firms_key_here

# ── OpenWeatherMap (https://openweathermap.org/api) ──
OPENWEATHER_API_KEY=your_openweather_key_here

# ── Google Cloud Vision AI (for photo analysis) ──
# Path to your Google Cloud service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# ── Security ────────────────────────────────────
# Comma-separated list of allowed origins in production (e.g. https://forestguard.example.com)
CORS_ORIGIN=
