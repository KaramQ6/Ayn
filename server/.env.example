# ForestGuard AI Server Environment Variables
PORT=5000
DB_PATH=./data/forestguard.db

# API Keys
NASA_FIRMS_KEY=your_nasa_firms_key_here
OPENWEATHER_KEY=your_openweathermap_key_here
GOOGLE_VISION_KEY=your_google_cloud_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# App Settings
DEMO_MODE=true
CORS_ORIGIN=*
