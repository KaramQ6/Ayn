# Ayn (عين) — Jordan Edition — Server Environment Variables

# Server
PORT=5000
NODE_ENV=development

# Database
DB_PATH=./data/forestguard.db

# API Keys (all optional — server falls back to demo mode when absent)
NASA_FIRMS_KEY=your_nasa_firms_key_here
OPENWEATHER_KEY=your_openweathermap_key_here
GOOGLE_VISION_KEY=your_google_cloud_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini — used for fire-cause analysis and star image identification.
# Without it, those features run in demo mode. https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Auth (REQUIRED in production — set a long random secret, min 32 chars)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-in-production

# Supabase (optional, only if using cloud auth/storage)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# App scope
# Comma-separated ISO country codes. Use * for all monitored countries (MENA).
# Jordan-only (default): ACTIVE_COUNTRIES=JO
# Expand later:          ACTIVE_COUNTRIES=JO,LB,PS
ACTIVE_COUNTRIES=JO

# Demo / data mode
DEMO_MODE=true

# CORS — comma-separated list of allowed origins (exact match or substring).
# In development with NODE_ENV=development, all origins are allowed automatically.
# In production, list your frontend domain(s):
#   CORS_ORIGIN=https://ayn-jordan.netlify.app,https://ayn.yourdomain.com
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
